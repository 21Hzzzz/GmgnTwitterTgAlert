# ==========================================
#  GmgnTwitterClaw 配置模板
#  复制此文件为 .env 并填入真实值
# ==========================================

# ---------- GMGN 上游 WebSocket 降噪 ----------
# 默认拦截高频行情订阅，降低 Playwright WS frame 回调压力；设为空则不拦截。
GMGN_BLOCK_WS_SUBSCRIBE_CHANNELS=chain_stat
# 每隔多少秒打印一次上游 WS 帧统计，用于观察 skipped/target/channel 分布。
GMGN_WS_FRAME_STATS_INTERVAL=600
# 每隔多少秒打印一次 GMGN 上游心跳包详情。
GMGN_HEARTBEAT_LOG_INTERVAL=600
# 重点诊断账号：这些 handle 的上游入站、去重、路由、投递会输出“🔎 诊断”日志。
DIAG_HANDLES=heyibinance,heyi,cz_binance,cz,elonmusk

# ---------- Telegram 推送配置 ----------
TG_BOT_TOKEN=123456789:ABCDefghIJKLmnopQRSTuvwxYZ123456789

# ---------- GMGN 登录与网络（首次登录时填写 AUTH_URL） ----------
FIRST_RUN_LOGIN=False
AUTH_URL=
# 可选，例如 socks5://127.0.0.1:40000；留空则直连。
PROXY_SERVER=

# 唯一的 Telegram 通知目标；所有监控消息都会发送到这里。
TG_ENABLE_DEFAULT=True
TG_CHANNEL_ID=-1001234567890

# 币安广场账号声明（逗号分隔的用户名小写），用于 TG 预览
BINANCE_SQUARE_HANDLES=cz,heyi,richardteng

# ---------- 机器翻译（普通推文直译，无需 API Key）----------
# 与聚合端油管/Ins 相同：Google → Microsoft → 腾讯交互翻译
TRANSLATE_PROVIDERS=google,microsoft,transmart

# ---------- DeepSeek AI 分析 / 定时频道总结 ----------
# 仅 AI_ANALYZE_HANDLES（如白毛股神）和 SUMMARY 使用，普通推文不再走 DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DeepSeek 模型；分析推荐 flash，需要更强分析可改为 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash

# 启用 AI 深度分析的博主列表（逗号分隔的小写用户名）
# 命中的博主走 DeepSeek：投资赛道分类（附带A股名称和代码）、智能摘要 + 翻译
AI_ANALYZE_HANDLES=aleabitoreddit,elonmusk

# ---------- 定时频道总结 ----------
# 默认按 SUMMARY_GROUPS 中的分组读取 TG_CHANNEL_ID_<GROUP> 作为数据源和推送目标。
SUMMARY_DB_PATH=twitter_monitor.db
SUMMARY_ENABLE=False
SUMMARY_TIMEZONE=Asia/Shanghai
SUMMARY_TIMES=07:30,20:00
SUMMARY_GROUPS=BINANCE
SUMMARY_LABEL_BINANCE=Binance
SUMMARY_MAX_TWEETS=120
SUMMARY_AI_TIMEOUT_SECONDS=180
SUMMARY_TWEET_TEXT_LIMIT=500
